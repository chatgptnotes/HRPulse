# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL (Supabase). Prisma reads this both for the app and for
# `prisma migrate deploy`, which runs at container start.
#
# IMPORTANT: use the DIRECT connection (port 5432), NOT the transaction pooler
# (port 6543). Migrations issue DDL and prepared statements that fail through
# PgBouncer in transaction mode. Railway runs one long-lived process, so the
# pooler buys nothing here.
#
# Supabase dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
#
# If you ever do need the pooler for the app, keep migrations on a direct
# connection: add `directUrl = env("DIRECT_URL")` to the datasource block in
# prisma/schema.prisma and set both:
#   DATABASE_URL=...pooler...:6543/postgres?pgbouncer=true
#   DIRECT_URL=...direct...:5432/postgres

# ── Server ───────────────────────────────────────────────────────────────────
# Railway injects PORT automatically — do NOT set it there. Local dev only.
PORT=3001

# Comma-separated allowed origins. Not needed when Express serves the frontend
# from the same origin (the production setup on Railway). Only required if the
# frontend is hosted separately, e.g. on Vercel.
# CORS_ORIGIN=https://hr-pulse-frontend.vercel.app

# ── SMTP (attendance notice emails) ──────────────────────────────────────────
# Seeded into the `settings` table on first boot, then editable in the UI.
# Gmail requires an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hr@yourcompany.com
SMTP_PASS=your-app-password

# ── Ollama (AI insights — optional) ──────────────────────────────────────────
# Leave as-is if no Ollama host is reachable from the deployment; the /api/ai
# routes will fail but nothing else depends on them.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Branding (email signatures) ──────────────────────────────────────────────
COMPANY_NAME=Your Company
HR_NAME=HR Department

# NOTE: working days per month is NOT read from the environment. It lives in the
# `settings` table as `working_days` (default 26), alongside
# `missed_swipe_weight` and `half_day_lop_weight`. Edit it in the UI.
