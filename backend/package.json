{
  "name": "@hrpulse/backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/backend/src/index.js",
    "worker": "node dist/backend/src/workers/integrationWorker.js",
    "worker:dev": "ts-node-dev --transpile-only src/workers/integrationWorker.ts",
    "test": "npm run build && node --test dist/backend/src/tests/*.test.js",
    "documents:migrate:dry-run": "node scripts/migrate-local-documents-to-storage.mjs",
    "documents:migrate": "node scripts/migrate-local-documents-to-storage.mjs --apply"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
