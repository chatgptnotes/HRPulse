generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTHENTICATION
// ─────────────────────────────────────────────────────────────────────────────

/// A person who can sign in to HR Pulse. Deliberately separate from `Employee`:
/// an employee is someone whose attendance is tracked, a user is someone who
/// operates the system. Most employees are not users.
model User {
  id    Int    @id @default(autoincrement())
  email String @unique

  /// bcrypt hash. Never the password itself, and never returned by any route.
  passwordHash String @map("password_hash")

  name String

  /// "admin" | "hr". admin may manage users; both may use the application.
  role String @default("hr")

  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// IDENTITY
// ─────────────────────────────────────────────────────────────────────────────

model Employee {
  id Int @id @default(autoincrement())

  /// Biometric / device-facing identifier. Retained as the value the attendance
  /// hardware and the SmartTime export carry for this person.
  employeeNumber String? @map("employee_number")

  /// Foreign key into Adamrit's accounting module: the employee's salary ledger.
  /// Nullable by design — an employee can exist here before a ledger is created
  /// in Adamrit. NULL means "not yet linked"; Postgres allows many NULLs under a
  /// UNIQUE index, so unlinked employees do not collide.
  adamritLedgerId String? @unique @map("adamrit_ledger_id")

  name         String
  email        String    @unique
  photoUrl     String?   @map("photo_url")
  organisation String?
  entity       String?
  department   String?
  designation  String?
  mobile       String?
  branch       String?
  status       String    @default("Active")
  shiftName    String    @default("General") @map("shift_name")
  shiftStartTime String  @default("09:00") @map("shift_start_time")
  shiftEndTime String    @default("18:00") @map("shift_end_time")
  eligibleForPaidLeaves Boolean @default(true) @map("eligible_for_paid_leaves")
  eligibleForOvertime Boolean @default(false) @map("eligible_for_overtime")
  joiningDate  DateTime? @map("joining_date")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  attendanceRecords AttendanceRecord[]
  emailDrafts       EmailDraft[]
  emailHistory      EmailHistory[]
  salaryConfigs     SalaryConfig[]
  employeeShifts    EmployeeShift[]
  biometricPunches  BiometricPunch[]

  /// Archive relations. Declared so Prisma retains the legacy tables; unused by
  /// application code.
  legacyAttendanceRecords LegacyAttendanceRecord[]
  legacySalaryConfigs     LegacySalaryConfig[]

  @@index([employeeNumber])
  @@map("employees")
}

// ─────────────────────────────────────────────────────────────────────────────
// SHIFTS
// ─────────────────────────────────────────────────────────────────────────────

/// A shift pattern. Times are stored as 24-hour wall-clock "HH:mm" strings
/// rather than as timestamps, because a shift is a recurring rule, not an
/// instant — it has no date and no timezone of its own.
model Shift {
  id String @id @default(uuid())

  /// Human label, e.g. "Nurse Morning 08:00-14:00", "General 09:00-18:00".
  name String @unique

  /// Role this pattern is intended for, e.g. "NURSE", "GENERAL".
  /// Free text for now — `Employee.designation` is unvalidated free text today,
  /// so a hard FK to a Role table would have nothing to point at until that
  /// data is cleaned up and backfilled.
  roleTarget String @map("role_target")

  /// "HH:mm", 24-hour.
  startTime String @map("start_time") @db.VarChar(5)
  /// "HH:mm", 24-hour.
  endTime   String @map("end_time") @db.VarChar(5)

  /// Minutes after startTime before an arrival counts as late.
  graceMinutes Int @default(15) @map("grace_minutes")

  /// True when endTime is on the calendar day after startTime. The three nurse
  /// shifts and the general shift are all same-day, so this is false for them;
  /// the flag exists so a future night shift does not require a migration.
  isOvernight Boolean @default(false) @map("is_overnight")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employeeShifts EmployeeShift[]

  @@index([roleTarget])
  @@map("shifts")
}

/// Assignment of a shift to an employee over a date range. Modelled per-employee
/// per-range rather than as a column on Employee because nurses rotate between
/// the three nurse patterns.
///
/// NOTE: overlapping ranges for one employee are not preventable by a Prisma
/// constraint (it needs a Postgres exclusion constraint over a daterange).
/// Resolution logic must therefore pick deterministically — see effectiveFrom
/// ordering — or a follow-up migration must add the exclusion constraint.
model EmployeeShift {
  id         String @id @default(uuid())
  employeeId Int    @map("employee_id")
  shiftId    String @map("shift_id")

  /// Inclusive first date this assignment applies.
  effectiveFrom DateTime  @map("effective_from") @db.Date
  /// Inclusive last date, or NULL for "open ended / current".
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([employeeId, shiftId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
  @@map("employee_shifts")
}

// ─────────────────────────────────────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────────────────────────────────────

/// Raw punch events as received from the biometric device. This table is
/// append-only source data: AttendanceRecord is derived from it, never the
/// reverse.
model BiometricPunch {
  id         String @id @default(uuid())
  employeeId Int    @map("employee_id")

  punchTime DateTime @map("punch_time")

  /// "IN" or "OUT".
  punchType String @map("punch_type") @db.VarChar(3)

  /// Identifier of the physical reader that produced the event.
  deviceId String? @map("device_id")

  createdAt DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Makes re-ingesting the same device export idempotent. Without this, a
  /// replayed feed silently doubles the punch stream and every derived figure.
  @@unique([employeeId, punchTime, punchType])
  @@index([employeeId, punchTime])
  @@map("biometric_punches")
}

model AttendanceRecord {
  id         Int @id @default(autoincrement())
  uploadId   Int @map("upload_id")
  employeeId Int @map("employee_id")

  /// True DATE column. Was a "yyyy-MM-dd" string, which could not be compared,
  /// ranged or indexed as a date.
  recordDate DateTime @map("record_date") @db.Date

  status String

  /// Resolved first-in / last-out instants for the day, derived from
  /// BiometricPunch. NULL until a punch feed populates them.
  timeIn  DateTime? @map("time_in")
  timeOut DateTime? @map("time_out")

  /// Minutes late against the resolved shift's startTime + graceMinutes, and
  /// minutes early against its endTime. 0 when on time or not yet computed.
  lateMinutes  Int @default(0) @map("late_minutes")
  earlyMinutes Int @default(0) @map("early_minutes")

  /// Original free-text time strings from the Excel import, preserved so the
  /// migration is not lossy. These are NOT parseable into timeIn/timeOut without
  /// knowing the source timezone; they exist for backfill and audit only.
  timeInRaw  String? @map("time_in_raw")
  timeOutRaw String? @map("time_out_raw")

  upload   AttendanceUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// One attendance row per person per day, period. The old table had no such
  /// constraint, which let a repeated upload duplicate every row and double the
  /// LOP figure derived from it. Deliberately NOT scoped by uploadId: two uploads
  /// covering the same month must collide rather than silently coexist.
  @@unique([employeeId, recordDate])
  @@index([uploadId])
  @@map("attendance_days")
}

model AttendanceUpload {
  id          Int      @id @default(autoincrement())
  filename    String
  periodMonth String   @map("period_month")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")
  rowCount    Int      @default(0) @map("row_count")
  status      String   @default("processed")

  records      AttendanceRecord[]
  emailDrafts  EmailDraft[]
  emailHistory EmailHistory[]

  /// Archive relation — see LegacyAttendanceRecord.
  legacyRecords LegacyAttendanceRecord[]

  @@map("attendance_uploads")
}

// ─────────────────────────────────────────────────────────────────────────────
// PAYROLL
// ─────────────────────────────────────────────────────────────────────────────

/// Monetary fields are Decimal(12,2), not Float. Binary floating point cannot
/// represent most decimal currency values exactly, and these amounts become
/// ledger debits in Adamrit.
model SalaryConfig {
  id             Int    @id @default(autoincrement())
  employeeId     Int    @map("employee_id")
  effectiveMonth String @map("effective_month")

  basicSalary Decimal @default(0) @map("basic_salary") @db.Decimal(12, 2)

  housingAllowance   Decimal @default(0) @map("housing_allowance") @db.Decimal(12, 2)
  transportAllowance Decimal @default(0) @map("transport_allowance") @db.Decimal(12, 2)
  otherAllowances    Decimal @default(0) @map("other_allowances") @db.Decimal(12, 2)
  otherDeductions    Decimal @default(0) @map("other_deductions") @db.Decimal(12, 2)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, effectiveMonth])
  @@map("salary_structures")
}

// ─────────────────────────────────────────────────────────────────────────────
// LEGACY TABLES — read-only archive, never written by the application
// ─────────────────────────────────────────────────────────────────────────────

/// The original `attendance_records` table, preserved exactly as it was.
///
/// Declared here so Prisma knows the table exists and will not propose dropping
/// it. Nothing in `backend/src` reads or writes this model; `AttendanceRecord`
/// (mapped to `attendance_days`) is the live table. Keep this model in the schema
/// for as long as you want the original data retained — which should be until you
/// have independently verified the copy.
model LegacyAttendanceRecord {
  id         Int     @id @default(autoincrement())
  uploadId   Int     @map("upload_id")
  employeeId Int     @map("employee_id")
  /// "yyyy-MM-dd" as text, the reason the copy exists.
  recordDate String  @map("record_date")
  status     String
  timeIn     String? @map("time_in")
  timeOut    String? @map("time_out")

  upload   AttendanceUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("attendance_records")
}

/// The original `salary_configs` table, preserved exactly as it was, including
/// `basicSalary` as a float.
model LegacySalaryConfig {
  id             Int    @id @default(autoincrement())
  employeeId     Int    @map("employee_id")
  basicSalary    Float  @default(0) @map("basic_salary")
  effectiveMonth String @map("effective_month")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, effectiveMonth])
  @@map("salary_configs")
}

/// Rows the copy could not carry into `attendance_days`, with the reason:
/// either an unparseable date, or a duplicate superseded by a later row for the
/// same employee and day. Every row here still exists untouched in
/// `attendance_records` — this table is the audit trail, not the backup.
model AttendanceRecordUnmigrated {
  id         Int      @id
  uploadId   Int      @map("upload_id")
  employeeId Int      @map("employee_id")
  recordDate String   @map("record_date")
  status     String
  timeIn     String?  @map("time_in")
  timeOut    String?  @map("time_out")
  reason     String
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@map("attendance_records_unmigrated")
}

/// One payroll calculation batch for one period. This is the artifact that makes
/// posting to Adamrit idempotent: amounts are frozen here at calculation time,
/// so a retry re-sends the same payload instead of recomputing a possibly
/// different one.
model PayrollRun {
  id String @id @default(uuid())

  /// "yyyy-MM". One run per period.
  periodMonth String @unique @map("period_month")

  /// draft | calculated | approved | posted | failed
  status String @default("draft")

  employeeCount   Int     @default(0) @map("employee_count")
  totalGross      Decimal @default(0) @map("total_gross") @db.Decimal(14, 2)
  totalDeductions Decimal @default(0) @map("total_deductions") @db.Decimal(14, 2)
  totalNet        Decimal @default(0) @map("total_net") @db.Decimal(14, 2)

  /// Frozen snapshot of the exact JSON body sent to Adamrit, and what came back.
  adamritPayload   Json?   @map("adamrit_payload")
  adamritResponse  Json?   @map("adamrit_response")
  /// Voucher / journal-voucher reference returned by Adamrit on success.
  adamritVoucherNo String? @map("adamrit_voucher_no")

  /// Stable key sent with the push so Adamrit can reject a duplicate retry.
  /// Derived from the run, not from wall-clock time.
  idempotencyKey String? @unique @map("idempotency_key")

  errorMessage String?   @map("error_message")
  calculatedAt DateTime? @map("calculated_at")
  approvedAt   DateTime? @map("approved_at")
  postedAt     DateTime? @map("posted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("payroll_runs")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS / CONFIG (unchanged)
// ─────────────────────────────────────────────────────────────────────────────

model EmailDraft {
  id           Int       @id @default(autoincrement())
  uploadId     Int       @map("upload_id")
  employeeId   Int       @map("employee_id")
  templateType String    @default("initial") @map("template_type")
  subject      String    @default("")
  body         String    @default("")
  isEdited     Boolean   @default(false) @map("is_edited")
  status       String    @default("pending")
  sentAt       DateTime? @map("sent_at")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")

  upload   AttendanceUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([uploadId, employeeId])
  @@map("email_drafts")
}

model EmailHistory {
  id           Int      @id @default(autoincrement())
  employeeId   Int      @map("employee_id")
  uploadId     Int?     @map("upload_id")
  subject      String
  body         String
  sentAt       DateTime @map("sent_at")
  status       String
  errorMessage String?  @map("error_message")

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  upload   AttendanceUpload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)

  @@map("email_history")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

model EmailTemplate {
  id      Int    @id @default(autoincrement())
  type    String @unique
  subject String
  body    String

  @@map("email_templates")
}

model Sop {
  id        Int      @id @default(autoincrement())
  title     String
  category  String
  content   String
  tags      String[] @default([])
  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sops")
}

model AttendanceRule {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  ruleType    String   @map("rule_type")
  conditions  Json
  actions     Json
  isActive    Boolean  @default(true) @map("is_active")
  priority    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("attendance_rules")
}

model AiInsight {
  id          Int      @id @default(autoincrement())
  uploadId    Int?     @map("upload_id")
  insightType String   @map("insight_type")
  title       String
  content     String
  severity    String   @default("info")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("ai_insights")
}

// ─────────────────────────────────────────────────────────────────────────────
// RULES ENGINE - Enterprise Dynamic Rule Management System
// ─────────────────────────────────────────────────────────────────────────────

/// Organize rules by business function and department
model RuleCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  icon        String?  // For UI display (material-icons name)
  color       String?  // For UI display (Tailwind color class)
  parentId    Int?     @map("parent_id")  // Support hierarchical categories
  parent      RuleCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  subcategories RuleCategory[] @relation("CategoryHierarchy")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rules       Rule[]

  @@map("rule_categories")
  @@index([isActive])
  @@index([parentId])
}

/// Main rule definitions for all business logic
model Rule {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  categoryId    Int      @map("category_id")
  category      RuleCategory @relation(fields: [categoryId], references: [id])

  // Rule classification
  ruleType      String   @map("rule_type")  // 'attendance', 'payroll', 'leave', 'hr', 'hospital', 'incentive', 'notification', 'compliance', 'custom'

  // Execution control
  isActive      Boolean  @default(true) @map("is_active")
  priority      Int      @default(0)
  executionMode String   @default("sync") @map("execution_mode")  // 'sync', 'async'

  // Metadata
  createdBy     String   @map("created_by")
  modifiedBy     String?  @map("modified_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relationships
  conditions    RuleCondition[]
  actions       RuleAction[]
  versions      RuleVersion[]
  approvals     RuleApproval[]
  permissions   RulePermission[]
  schedules     RuleSchedule[]
  logs          RuleExecutionLog[]

  @@map("rules")
  @@index([categoryId])
  @@index([ruleType])
  @@index([isActive])
  @@index([priority])
}

/// Rule conditions - IF/AND/OR logic with support for nested groups
model RuleCondition {
  id            Int      @id @default(autoincrement())
  ruleId        Int      @map("rule_id")
  rule          Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // Condition structure for nested/grouped conditions
  parentId      Int?     @map("parent_id")  // For nested conditions
  parent        RuleCondition? @relation("ConditionTree", fields: [parentId], references: [id])
  children      RuleCondition[] @relation("ConditionTree")

  logicalOperator String? @map("logical_operator")  // 'AND', 'OR' - for groups

  // Actual condition (leaf nodes)
  field         String   // e.g., 'attendance.workingHours', 'employee.designation'
  operator      String   // 'eq', 'ne', 'gt', 'lt', 'gte', 'lte', 'contains', 'notContains', 'startsWith', 'endsWith', 'in', 'notIn', 'between'
  value         String   @db.Text  // JSON serialized value for complex types
  valueType     String   @map("value_type")  // 'string', 'number', 'boolean', 'date', 'list', 'json'

  displayOrder  Int      @map("display_order")

  @@map("rule_conditions")
  @@index([ruleId])
  @@index([parentId])
}

/// Rule actions - THEN logic with multiple action types
model RuleAction {
  id            Int      @id @default(autoincrement())
  ruleId        Int      @map("rule_id")
  rule          Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // Action structure for grouping
  groupId       Int?     @map("group_id")  // For grouping multiple actions

  actionType    String   @map("action_type")  // 'set', 'add', 'subtract', 'multiply', 'divide', 'sendNotification', 'approve', 'reject', 'calculate', 'validate'
  targetField   String?  @map("target_field")  // What field to affect

  // Action parameters
  value         String?  @db.Text  // JSON serialized for complex values
  valueType     String?  @map("value_type")  // 'fixed', 'fieldReference', 'formula', 'percentage'

  formula       String?  @db.Text  // For calculation actions
  amount        Decimal? @db.Decimal(10, 2)
  percent       Decimal? @db.Decimal(5, 2)  @map("percent")

  // Notification actions
  notificationTemplate String?  @map("notification_template")
  notificationRecipients String? @map("notification_recipients")  // JSON array

  // Constraints
  minValue      Decimal? @map("min_value")
  maxValue      Decimal? @map("max_value")
  roundTo       Int?     @map("round_to")  // Decimal places

  displayOrder  Int      @map("display_order")

  @@map("rule_actions")
  @@index([ruleId])
  @@index([groupId])
}

/// Version history with rollback capability
model RuleVersion {
  id            Int      @id @default(autoincrement())
  ruleId        Int      @map("rule_id")
  rule          Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  versionNumber Int      @map("version_number")

  // Complete rule snapshot
  name          String
  description   String?
  conditions    Json     // Full conditions tree
  actions       Json     // Full actions array

  // Metadata
  changeSummary String?  @map("change_summary")
  modifiedBy    String   @map("modified_by")
  modifiedAt    DateTime @default(now()) @map("modified_at")

  // Approval status
  approvalStatus String? @map("approval_status")  // 'pending', 'approved', 'rejected'
  approvedBy    String?  @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  rejectionReason String? @map("rejection_reason")

  isRollback    Boolean  @default(false) @map("is_rollback")

  @@map("rule_versions")
  @@index([ruleId])
  @@index([versionNumber])
  @@unique([ruleId, versionNumber])
}

/// Approval workflow for rule changes
model RuleApproval {
  id            Int      @id @default(autoincrement())
  ruleId        Int      @map("rule_id")
  rule          Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // Request details
  requestedBy   String   @map("requested_by")
  requestedAt   DateTime @default(now()) @map("requested_at")
  requestType   String   @map("request_type")  // 'create', 'update', 'activate', 'deactivate', 'delete'

  // Change details
  changeSummary String?  @map("change_summary")
  changes       Json?    // Detailed diff

  // Approval details
  approvalLevel Int      @default(1) @map("approval_level")
  requiredApprovals Int  @default(1) @map("required_approvals")
  currentApprovals Int   @default(0) @map("current_approvals")

  // Status
  status        String   @default("pending")  // 'pending', 'approved', 'rejected', 'cancelled'

  // Approval chain
  approvers     Json     // Array of required approvers
  approvals     Json?    // Array of completed approvals

  // Final decision
  approvedBy    String?  @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  rejectionReason String? @map("rejection_reason")

  @@map("rule_approvals")
  @@index([ruleId])
  @@index([status])
  @@index([requestedBy])
}

/// Role-based access control for rules
model RulePermission {
  id            Int      @id @default(autoincrement())
  ruleId        Int      @map("rule_id")
  rule          Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  role          String   // 'admin', 'hr_manager', 'payroll_manager', 'department_head', 'viewer'
  permissions   Json     // ['view', 'create', 'edit', 'delete', 'activate', 'test']

  grantedBy     String   @map("granted_by")
  grantedAt     DateTime @default(now()) @map("granted_at")

  @@map("rule_permissions")
  @@index([ruleId])
  @@index([role])
}

/// Complete audit trail of rule executions
model RuleExecutionLog {
  id            Int      @id @default(autoincrement())
  ruleId        Int      @map("rule_id")
  rule          Rule     @relation(fields: [ruleId], references: [id])

  // Execution context
  employeeId    Int?     @map("employee_id")
  entityType   String?  @map("entity_type")  // 'employee', 'attendance', 'leave', 'payroll', etc.
  entityId      Int?     @map("entity_id")

  // Execution details
  executedAt    DateTime @default(now()) @map("executed_at")
  executionDuration Int? @map("execution_duration")  // milliseconds
  triggerSource String?  @map("trigger_source")  // 'manual', 'scheduled', 'api', 'batch_job'

  // Input/Output
  inputData     Json?    @map("input_data")
  outputData    Json?    @map("output_data")
  matchedConditions Json? @map("matched_conditions")
  executedActions Json?  @map("executed_actions")

  // Result
  status        String   // 'success', 'failed', 'partial', 'skipped'
  errorMessage  String?  @map("error_message")
  errorCode     String?  @map("error_code")

  // Metadata
  executedBy    String?  @map("executed_by")  // System or user who triggered
  batchId       String?  @map("batch_id")     // For grouping related executions

  @@map("rule_execution_logs")
  @@index([ruleId])
  @@index([employeeId])
  @@index([status])
  @@index([executedAt])
  @@index([entityType, entityId])
}

/// Scheduled rule execution configuration
model RuleSchedule {
  id            Int      @id @default(autoincrement())
  ruleId        Int      @map("rule_id")
  rule          Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  name          String
  description   String?

  // Schedule configuration
  scheduleType  String   @map("schedule_type")  // 'cron', 'interval', 'event'
  cronExpression String? @map("cron_expression")
  intervalMinutes Int?    @map("interval_minutes")
  eventType     String?  @map("event_type")     // 'attendance_processed', 'leave_approved', etc.

  // Execution settings
  isActive      Boolean  @default(true) @map("is_active")
  runAsynchronously Boolean @default(false) @map("run_asynchronously")

  // Timezone and constraints
  timezone      String   @default("UTC")
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")

  // Last/Next execution
  lastExecutedAt DateTime? @map("last_executed_at")
  nextExecutionAt DateTime? @map("next_execution_at")

  // Metadata
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("rule_schedules")
  @@index([ruleId])
  @@index([isActive])
  @@index([nextExecutionAt])
}

/// Track AI-generated rules with feedback loop
model AIRuleGenerationHistory {
  id            Int      @id @default(autoincrement())
  ruleId        Int?     @map("rule_id")  // Null if rule wasn't saved

  // Input
  naturalLanguageQuery String @map("natural_language_query") @db.Text
  clarifyingQuestions Json?  @map("clarifying_questions")
  userAnswers     Json?    @map("user_answers")

  // Generation details
  aiProvider    String   @map("ai_provider")  // 'openai', 'claude', 'gemini'
  modelUsed     String   @map("model_used")
  tokensUsed    Int      @map("tokens_used")
  cost          Decimal? @db.Decimal(8, 4)

  // Output
  generatedRule Json     @map("generated_rule")
  wasModified    Boolean @default(false) @map("was_modified")
  wasSaved       Boolean @default(false) @map("was_saved")

  // Feedback
  userRating    Int?     @map("user_rating")  // 1-5 stars
  userFeedback  String?  @map("user_feedback") @db.Text

  // Metadata
  requestedBy   String   @map("requested_by")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("ai_rule_generation_history")
  @@index([ruleId])
  @@index([requestedBy])
  @@index([createdAt])
}
